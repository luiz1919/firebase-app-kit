{
  "name": "firebase-app-kit",
  "version": "0.15.0",
  "private": true,
  "description": "Shared building blocks of the Vite + React + Firebase apps (CommunityAssistant, TripPlanner, Labia, Supermerk2)",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "styles",
    "config",
    "sw",
    "rules",
    "bin",
    "globals.d.ts"
  ],
  "bin": {
    "firebase-app-kit": "bin/firebase-app-kit.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "default": "./dist/ai/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./ui.css": "./styles/ui.css",
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./deploy": {
      "types": "./dist/deploy.d.ts",
      "default": "./dist/deploy.js"
    },
    "./rules-testing": {
      "types": "./dist/rulesTesting.d.ts",
      "default": "./dist/rulesTesting.js"
    },
    "./globals": {
      "types": "./globals.d.ts"
    },
    "./config/*": "./config/*",
    "./rules/*": "./rules/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint",
    "test": "node --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:rules": "firebase emulators:exec --config firebase.emulator.json --project demo-firebase-app-kit --only firestore \"node --test tests/emulator/*.test.ts\""
  },
  "peerDependencies": {
    "firebase": ">=12",
    "react": ">=18",
    "typescript": ">=5.5",
    "vite": ">=7"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "firebase": "^13.2.0",
    "oxlint": "^1.90.0",
    "react": "^19.3.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  },
  "engines": {
    "node": ">=22.18"
  }
}
