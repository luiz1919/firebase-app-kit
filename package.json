{
  "name": "firebase-app-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Piezas comunes de las apps Vite + React + Firebase (CommunityAssistant, TripPlanner)",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist",
    "config",
    "globals.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./deploy": {
      "types": "./dist/deploy.d.ts",
      "default": "./dist/deploy.js"
    },
    "./globals": {
      "types": "./globals.d.ts"
    },
    "./config/*": "./config/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint",
    "test": "node --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "firebase": ">=12",
    "typescript": ">=5.5",
    "vite": ">=7"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "firebase": "^13.2.0",
    "oxlint": "^1.90.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  },
  "engines": {
    "node": ">=22.18"
  }
}
